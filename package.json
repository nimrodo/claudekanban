{
  "name": "claudekanban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist-extension/extension/extension.js",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22"
  },
  "contributes": {
    "commands": [
      {
        "command": "claudekanban.openBoard",
        "title": "ClaudeKanban: Open Board"
      },
      {
        "command": "claudekanban.installHooks",
        "title": "ClaudeKanban: Install Hooks"
      }
    ],
    "configuration": {
      "title": "ClaudeKanban",
      "properties": {
        "claudekanban.dbPath": {
          "type": "string",
          "default": "",
          "description": "Path to the SQLite database file for the Managed server. Defaults to a workspace-scoped path under the extension's own storage. Set this to a Standalone server's claudekanban.db path to share history across both modes."
        }
      }
    }
  },
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:frontend": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-server-assets.js",
    "build:extension": "tsc -p extension/tsconfig.json",
    "package:extension": "npm run build && npm run build:server && npm run build:extension",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p extension/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "hooks:install": "tsx scripts/install-hooks.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.0",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.100.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
